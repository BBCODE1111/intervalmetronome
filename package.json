{
  "name": "intervalmetronome",
  "version": "1.3.0",
  "private": true,
  "description": "Interval metronome for guitar and instrument practice",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test",
    "preview": "node scripts/serve.mjs",
    "generate:voice": "node scripts/voice-generator/generate.mjs",
    "qa:browser": "npm run build && node scripts/prepare-browser-qa.mjs",
    "generate:recorded": "node scripts/recorded-voice/generate.mjs"
  },
  "devDependencies": {
    "@fontsource/orbitron": "5.3.0",
    "@soundtouchjs/core": "2.1.1",
    "@tailwindcss/node": "4.3.3",
    "esbuild": "0.25.12",
    "tailwindcss": "4.3.3"
  }
}
